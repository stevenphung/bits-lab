{
  "name": "bits-lab",
  "version": "0.1.2",
  "description": "Game feel for real products: 169 original React components for quests, achievements, progress, combos, streaks and hold-to-confirm, in a playful 8-bit style. Zero dependencies, styles included.",
  "license": "MIT",
  "author": "Steven Phung",
  "homepage": "https://bits-lab.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevenphung/bits-lab.git",
    "directory": "packages/bits-lab"
  },
  "bugs": {
    "url": "https://github.com/stevenphung/bits-lab/issues"
  },
  "keywords": [
    "react",
    "components",
    "gamification",
    "game-ui",
    "onboarding",
    "achievements",
    "micro-interactions",
    "animation",
    "pixel",
    "8-bit",
    "ui"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "matter-js": ">=0.19",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "matter-js": {
      "optional": true
    }
  }
}
